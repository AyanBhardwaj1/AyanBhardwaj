# ayan-bot (POST /api/ayan-bot). Set these in the Vercel dashboard, never in git.
# Server-only: do NOT prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional. Defaults to gpt-6-luna.
OPENAI_MODEL=
# Optional. 1 = canned replies, no OpenAI calls (dev runs mock automatically without a key).
AYAN_BOT_MOCK=
