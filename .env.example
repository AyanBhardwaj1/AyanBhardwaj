# ayan-bot (POST /api/ayan-bot). Set these in the Vercel dashboard, never in git.
# Server-only: do NOT prefix any of these with NEXT_PUBLIC_.

# --- Model ---
OPENAI_API_KEY=
# Optional. Defaults to gpt-6-luna. Another model is priced conservatively
# ($2.50 / $10 per 1M tokens) unless you set its prices below.
OPENAI_MODEL=
# Optional prices in USD per 1M tokens, used by the spend cap.
AYAN_BOT_PRICE_IN_PER_M=
AYAN_BOT_PRICE_OUT_PER_M=

# --- Spend cap (hard) ---
# Each request reserves its worst-case cost before calling the model; when a
# budget is used up, ayan-bot falls back to its free canned briefs.
# Defaults: 0.50 a day, 5 a month (UTC).
AYAN_BOT_DAILY_BUDGET_USD=
AYAN_BOT_MONTHLY_BUDGET_USD=

# --- Shared counters (strongly recommended in production) ---
# Vercel Marketplace > Upstash for Redis sets these automatically. Without
# them, budgets and rate limits are per server instance (best effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Security ---
# Optional HMAC key (32+ random characters) for proof-of-work tickets.
# Defaults to a key derived from OPENAI_API_KEY.
AYAN_BOT_SECRET=
# Optional base proof-of-work difficulty in bits (8-20, default 15).
AYAN_BOT_POW_BITS=

# --- Switches ---
# 1 = kill switch: no model calls at all, canned briefs only.
AYAN_BOT_DISABLED=
# 1 = canned replies, no OpenAI calls (dev runs mock automatically without a key).
AYAN_BOT_MOCK=
